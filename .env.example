# Copy to .env and fill in as needed.

# Backend API base. Leave unset to auto-detect:
#   - local dev (localhost:5173/5174) → http://localhost:8080
#   - hosted → same origin
# Point at production instead:
# VITE_API_BASE=https://server.manchly.com

# ZegoCloud 1:1 video calls (web needs AppID + ServerSecret; the mobile
# AppSign cannot be used in the browser). Without these, calls still run the
# session lifecycle (ring/accept/end/billing) but without in-browser video.
# VITE_ZEGO_APP_ID=2106372521
# VITE_ZEGO_SERVER_SECRET=your_32_char_server_secret
